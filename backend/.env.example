# Leave OPENAI_API_KEY blank to run fully in demo mode (no AI calls are made, no key needed)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
# Leave GEMINI_API_KEY blank to skip real Gemini inference. When set, Gemini takes precedence
# over OpenAI as the real vision provider (see app/providers/__init__.py get_provider()).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# SQLite is the default and requires no setup. Swap to Postgres by setting e.g.:
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/mbanalysis
DATABASE_URL=sqlite:///./mbanalysis.db
# Max upload size in megabytes
MAX_UPLOAD_MB=25
# Comma separated list of allowed upload extensions
ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.tif,.tiff
ENVIRONMENT=development
# Comma separated list of origins allowed to call the API (CORS). In production, set this to
# the deployed frontend's origin, e.g. ALLOWED_ORIGINS=https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# --- Auth (see README "Authentication Setup") ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Leave blank here; set a real random value only in your local, uncommitted .env.
# If left blank with ENVIRONMENT=development, a random secret is generated per process start
# (all existing sessions are invalidated on every restart). Left blank in any other
# ENVIRONMENT, the app refuses to start.
JWT_SECRET=
# Bootstrap admin account - set these, run `alembic upgrade head` then `python create_admin.py`
# once. Use a throwaway value locally; never a real personal password, and never commit a real one.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Public "Try the demo" read-only viewer account (POST /api/auth/demo-login). Created lazily on
# first call to that endpoint, always role=viewer. There is no DEMO_PASSWORD - that endpoint
# never takes or checks a password, so there is nothing to protect. Change this only if you want
# the demo account under a different email; the default below works out of the box.
DEMO_EMAIL=demo@mbanalysis.local

# --- OCR (PaddleOCR: local, free, CPU, no API key - see README "OCR vs AI Vision Interpretation") ---
OCR_ENABLED=true
OCR_LANGUAGE=en
OCR_USE_GPU=false
PDF_RENDER_DPI=288
OCR_CONFIDENCE_THRESHOLD=0.5
OCR_PREPROCESS_DESKEW=false
OCR_PREPROCESS_CLAHE=true
OCR_PREPROCESS_DENOISE=false
