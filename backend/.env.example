# Leave OPENAI_API_KEY blank to run fully in demo mode (no AI calls are made, no key needed)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
# SQLite is the default and requires no setup. Swap to Postgres by setting e.g.:
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/mbanalysis
DATABASE_URL=sqlite:///./mbanalysis.db
# Max upload size in megabytes
MAX_UPLOAD_MB=25
# Comma separated list of allowed upload extensions
ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.tif,.tiff
ENVIRONMENT=development

# --- Auth (see README "Authentication Setup") ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Leave blank here; set a real random value only in your local, uncommitted .env.
# If left blank with ENVIRONMENT=development, a random secret is generated per process start
# (all existing sessions are invalidated on every restart). Left blank in any other
# ENVIRONMENT, the app refuses to start.
JWT_SECRET=
# Bootstrap admin account - set these, run `alembic upgrade head` then `python create_admin.py`
# once. Use a throwaway value locally; never a real personal password, and never commit a real one.
ADMIN_EMAIL=
ADMIN_PASSWORD=
