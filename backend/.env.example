# Leave OPENAI_API_KEY blank to run fully in demo mode (no AI calls are made, no key needed)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
# SQLite is the default and requires no setup. Swap to Postgres by setting e.g.:
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/mbanalysis
DATABASE_URL=sqlite:///./mbanalysis.db
# Max upload size in megabytes
MAX_UPLOAD_MB=25
# Comma separated list of allowed upload extensions
ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.tif,.tiff
ENVIRONMENT=development

# --- Auth (NOT YET IMPLEMENTED in this codebase revision; placeholders
# reserved for planned JWT auth work -- see README "Known gaps") ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Leave blank here; set a real random value only in your local, uncommitted .env.
JWT_SECRET=
# Bootstrap admin account for first run once auth lands. Use a throwaway
# value locally; never a real personal password, and never commit a real one.
ADMIN_EMAIL=
ADMIN_PASSWORD=
